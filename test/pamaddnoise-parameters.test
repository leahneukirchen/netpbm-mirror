#! /bin/sh
# This script tests: pamaddnoise
# Also requires:

echo "Test Invalid"

. ./test-invalid.inc

echo empty input file
invCmd "pamaddnoise  /dev/null"

echo no type specified
invCmd "pamaddnoise -type testgrid.pbm"
invCmd "pamaddnoise -type none testgrid.pbm"

echo type gaussian implied
invCmd "pamaddnoise -sigma1=-4.0 testgrid.pbm"
invCmd "pamaddnoise -sigma2=-20.0 testgrid.pbm"
invCmd "pamaddnoise -mgsigma=0.5 testgrid.pbm"
invCmd "pamaddnoise -lsigma=10.0 testgrid.pbm"
invCmd "pamaddnoise -tolerance=0.10 testgrid.pbm"
invCmd "pamaddnoise -salt=0.50 testgrid.pbm"
invCmd "pamaddnoise -lambda=12.0 testgrid.pbm"

echo type gaussian explicitly stated
invCmd "pamaddnoise -type gaussian -sigma1=-0.01 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -sigma2=-0.01 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -mgsigma=0.5 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -lsigma=10.0 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -tolerance=0.10 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -salt=0.50 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -lambda=12.0 testgrid.pbm"

echo type multiplicative gaussian
invCmd "pamaddnoise -type multiplicative_gaussian -sigma1=4.0 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -sigma2=20.0 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -mgsigma=-0.5 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -lsigma=10.0 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -tolerance=0.10 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -salt=0.50 testgrid.pbm"
invCmd "pamaddnoise -type multiplicative_gaussian -lambda=12.0 testgrid.pbm"

echo type laplacian
invCmd "pamaddnoise -type laplacian -sigma1=4.0 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -sigma2=20.0 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -mgsigma=0.5 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -lsigma=-10.0 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -tolerance=0.10 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -salt=0.50 testgrid.pbm"
invCmd "pamaddnoise -type laplacian -lambda=12.0 testgrid.pbm"

echo type impulse
invCmd "pamaddnoise -type impulse -sigma1=4.0 testgrid.pbm"
invCmd "pamaddnoise -type impulse -sigma2=20.0 testgrid.pbm"
invCmd "pamaddnoise -type impulse -mgsigma=0.5 testgrid.pbm"
invCmd "pamaddnoise -type impulse -lsigma=10.0 testgrid.pbm"
invCmd "pamaddnoise -type impulse -tolerance=-0.10 testgrid.pbm"
invCmd "pamaddnoise -type impulse -tolerance=1.10 testgrid.pbm"
invCmd "pamaddnoise -type impulse -salt=-0.10 testgrid.pbm"
invCmd "pamaddnoise -type impulse -salt=+1.10 testgrid.pbm"
invCmd "pamaddnoise -type impulse -lambda=12.0 testgrid.pbm"

echo type poisson
invCmd "pamaddnoise -type poisson -sigma1=4.0 testgrid.pbm"
invCmd "pamaddnoise -type poisson -sigma2=20.0 testgrid.pbm"
invCmd "pamaddnoise -type poisson -mgsigma=0.5 testgrid.pbm"
invCmd "pamaddnoise -type poisson -lsigma=10.0 testgrid.pbm"
invCmd "pamaddnoise -type poisson -tolerance=0.10 testgrid.pbm"
invCmd "pamaddnoise -type poisson -salt=0.50 testgrid.pbm"
invCmd "pamaddnoise -type poisson -lambda=0 testgrid.pbm"

echo missing or invalid numerical parameters
invCmd "pamaddnoise -sigma1 testgrid.pbm"
invCmd "pamaddnoise -sigma1 Z testgrid.pbm"
invCmd "pamaddnoise -type gaussian -sigma2 testgrid.pbm"
invCmd "pamaddnoise -type gaussian -sigma2 sigma testgrid.pbm"
invCmd "pamaddnoise -type mult -mgsigma testgrid.pbm"
invCmd "pamaddnoise -type mult -mgsigma 10,0 testgrid.pbm"
invCmd "pamaddnoise -type lapl -lsigma 1..0 testgrid.pbm"
invCmd "pamaddnoise -type lapl -lsigma lsigma testgrid.pbm"
invCmd "pamaddnoise -type impul -tolerance testgrid.pbm"
invCmd "pamaddnoise -type impul -tolerance t testgrid.pbm"
invCmd "pamaddnoise -type impul -salt testgrid.pbm"
invCmd "pamaddnoise -type impul -salt pepper testgrid.pbm"
invCmd "pamaddnoise -type pois -lambda testgrid.pbm"
invCmd "pamaddnoise -type pois -lambda L testgrid.pbm"
invCmd "pamaddnoise -seed -1 testgrid.pbm"
invCmd "pamaddnoise -seed random testgrid.pbm"
