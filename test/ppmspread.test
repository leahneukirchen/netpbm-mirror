#! /bin/sh
# This script tests: ppmspread
# Also requires: pamfile ppmtopgm pgmtopbm

# Input/output size does not change

echo "Test 1."
cat testimg.ppm | pamfile -machine
ppmspread -randomseed=8353 20 testimg.ppm | pamfile -machine

echo "Test 2."
pamfile -size maze.pbm
ppmspread -randomseed=8443 20 maze.pbm | pamfile -size

# No change when spread distance value is 0

echo "Test 3. Should print 281226646 481 twice"
cat maze.pbm | ppmtopgm | pgmtopbm | cksum
ppmspread -randomseed=8533 0 maze.pbm | ppmtopgm | pgmtopbm | cksum

# The following tests will fail when the seed value is changed or
# changes are made to the random number generator

echo "Test 4. Should print 3580853691 101484"
ppmspread -randomseed=8623 10 testimg.ppm | cksum

echo "Test 5. Should print 4108303021 685"
ppmspread -randomseed=8713 1 testgrid.pbm | cksum

echo "Test Invalid."

. ./test-invalid.inc

invCmd "ppmspread 1 /dev/null"
