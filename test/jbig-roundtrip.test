#! /bin/sh
# This script tests: pnmtojbig jbigtopnm
# Also requires: pamchannel pamtopnm pamdepth

tmpdir=${tmpdir:-/tmp}
test_pam=${tmpdir}/testimg.pam
test_pgm=${tmpdir}/testimg.pgm

echo Test 1.  Should print 281226646 481
pnmtojbig maze.pbm | jbigtopnm | cksum

echo Test 2.  Should print 1571496937 33838 seven times
pamchannel -infile=testimg.ppm -tupletype="GRAYSCALE" 0 | \
  tee ${test_pam} | pamtopnm | \
  tee ${test_pgm} | pnmtojbig | jbigtopnm | cksum

for maxval in 511 2047 8191
  do
  pamdepth ${maxval} ${test_pgm} | pnmtojbig | jbigtopnm | pamdepth 255 | cksum
  done
for maxval in 1023 4095 65535
  do
  pamdepth ${maxval} ${test_pam} | pnmtojbig | jbigtopnm | pamdepth 255 | cksum
  done

rm ${test_pgm} ${test_pam}
