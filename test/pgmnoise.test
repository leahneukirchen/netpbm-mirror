#! /bin/sh
# This script tests: pgmnoise
# Also requires: pamnoise pamtable pgmtopgm

echo "Test 1."
echo "Should print: 90 2a bb 1c 6e 5f ae 00 1a 4f 31 16 c9 c2 d5 84 a2 ed 74 e7 twice "
# (Mersenne Twister)
pgmnoise --randomseed=3812 20 1 | pamtable -hex
pamnoise --randomseed=3812 -w 20 -h 1 -d 1 | pamtable -hex

echo "Test 2."
echo "Should print: 21 98 88 33 25 43 45 83 13 30 63 67 81 51 50 32 27 65 53 86 twice "
pgmnoise --randomseed=3831 -maxval 99 20 1 | pamtable
pamnoise --randomseed=3831 -maxval 99 -w 20 -h 1 -d 1 | pamtable

echo "Test 3."
echo "Should print: 3193754496 1103 twice "
pgmnoise --randomseed=3850 -maxval 65535 32 17 | cksum
pamnoise --randomseed=3850 -maxval 65535 -w 32 -h 17 -d 1 -tupletype="GRAYSCALE" |\
    pgmtopgm | cksum
