#! /bin/sh
# This script tests: pamscale
# Also requires:

echo "Test 1"

pamscale -reportonly 3 testimg.ppm
pamscale -reportonly 5 testimg.ppm
pamscale -reportonly -xysize 640 400 testimg.ppm
pamscale -reportonly -xyfill 640 400 testimg.ppm
pamscale -reportonly -xyfit  100 100 testimg.ppm
pamscale -reportonly -reduce 6 testimg.ppm
pamscale -reportonly -reduce 10 testimg.ppm
pamscale -reportonly -xsize=640 -ysize=400 testimg.ppm
pamscale -reportonly -width=640 -height=400 testimg.ppm
pamscale -reportonly -width=640 -yscale=2 testimg.ppm
pamscale -reportonly -xscale=1.4 -height=400 testimg.ppm
pamscale -reportonly -pixels=45000 testimg.ppm

echo "Test Invalid"

. ./test-invalid.inc

# Expected failure cases

invCmd "pamscale -reportonly /dev/null"

invCmd "pamscale -reportonly -xsize=-10 -ysize=400 testimg.ppm"
invCmd "pamscale -reportonly -xsize=0   -ysize=400 testimg.ppm"
invCmd "pamscale -reportonly -xsize=640 -ysize=-10 testimg.ppm"
invCmd "pamscale -reportonly -xsize=640 -ysize=0   testimg.ppm"

invCmd "pamscale -reportonly -xscale=-10 -yscale=2   testimg.ppm"
invCmd "pamscale -reportonly -xscale=0   -yscale=2   testimg.ppm"
invCmd "pamscale -reportonly -xscale=4   -yscale=-10 testimg.ppm"
invCmd "pamscale -reportonly -xscale=6   -yscale=0   testimg.ppm"

invCmd "pamscale -reportonly -xysize   0  400 testimg.ppm"
invCmd "pamscale -reportonly -xysize -10  400 testimg.ppm"
invCmd "pamscale -reportonly -xysize 200    0 testimg.ppm"
invCmd "pamscale -reportonly -xysize 200 -400 testimg.ppm"
invCmd "pamscale -reportonly -xysize 200      testimg.ppm"

invCmd "pamscale -reportonly -xyfit    0  400 testimg.ppm"
invCmd "pamscale -reportonly -xyfit  -10  400 testimg.ppm"
invCmd "pamscale -reportonly -xyfit  200    0 testimg.ppm"
invCmd "pamscale -reportonly -xyfit  200 -400 testimg.ppm"
invCmd "pamscale -reportonly -xyfit  200      testimg.ppm"

invCmd "pamscale -reportonly -xyfill   0  400 testimg.ppm"
invCmd "pamscale -reportonly -xyfill -10  400 testimg.ppm"
invCmd "pamscale -reportonly -xyfill 200    0 testimg.ppm"
invCmd "pamscale -reportonly -xyfill 200 -400 testimg.ppm"
invCmd "pamscale -reportonly -xyfill 200      testimg.ppm"

invCmd "pamscale -reportonly -xsize=640 -ysize=400 -xscale=2 testimg.ppm"
invCmd "pamscale -reportonly -xsize=640 -xscale=2 -yscale=3 testimg.ppm"
invCmd "pamscale -reportonly -pixels=0 testimg.ppm"

invCmd "pamscale -reportonly -xysize 640 400 -xyfit  640 400 testimg.ppm"
invCmd "pamscale -reportonly -xysize 640 400 -xyfill 640 400 testimg.ppm"
invCmd "pamscale -reportonly -xyfit  640 400 -xyfill 640 400 testimg.ppm"

