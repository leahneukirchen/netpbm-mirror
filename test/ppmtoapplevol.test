  #! /bin/sh
# This script tests: ppmtoapplevol 
# Also requires: ppmmake pbmmake

echo "Test: should print 1518149010 3065"
ppmmake rgb:0/0/0 255 12 | ppmtoapplevol | cksum


echo "Test Invalid"

. ./test-invalid.inc

invCmd "ppmtoapplevol /dev/null"

tmpdir=${tmpdir:-/tmp}
test_input=${tmpdir}/test_input

pbmmake 10 11 > ${test_input}
invCmd "ppmtoapplevol ${test_input}"
rm -f ${test_input}
  
pbmmake 10 13 > ${test_input}
invCmd "ppmtoapplevol ${test_input}"
rm -f ${test_input}

pbmmake 256 12 > ${test_input}
invCmd "ppmtoapplevol ${test_input}"
rm -f ${test_input}
