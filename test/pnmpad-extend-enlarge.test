#! /bin/sh
# This script tests: pnmpad pamenlarge
# Also requires: pamcut pamnoise pamrestack pamseq pamtopnm pamundice
# Also requires: pbmmake pbmnoise pgmmake pgmtopgm ppmmake

# This test script shows how to eemulate the -extend-edge function of pnmpad
# with pamenlarge.

# If the padding function for -extend-edge is altered, make sure to run this
# test.  Try more sizes.  For instnce change "for i in 1 2" to "for i in `seq 32`" .

# Random seed values do not affect output; they can be altered.  Leaving out the
# -randomseed option is also okay.

tmpdir=${tmpdir:-/tmp}
test_pnm=${tmpdir}/test.pnm
seq_pnm=${tmpdir}/seq.pnm

padded_pnm=${tmpdir}/padded.pnm
#middle_pnm=${tmpdir}/middle.pnm
left_pnm=${tmpdir}/left.pnm
right_pnm=${tmpdir}/right.pnm
top_pnm=${tmpdir}/top.pnm
bottom_pnm=${tmpdir}/bottom.pnm
topleft_pnm=${tmpdir}/topleft.pnm
topright_pnm=${tmpdir}/topright.pnm
bottomleft_pnm=${tmpdir}/bottomleft.pnm
bottomright_pnm=${tmpdir}/bottomright.pnm
listfile=${tmpdir}/listfile

# Set up pamundice listfile

echo ${topleft_pnm} ${top_pnm} ${topright_pnm} \
     ${left_pnm} ${test_pnm} ${right_pnm} \
     ${bottomleft_pnm} ${bottom_pnm} ${bottomright_pnm} | tr ' ' '\n' > ${listfile}


echo "Test 1.  Should print match seven times"

pamseq -tupletype="RGB" 6 3 | pamrestack -w 64 | pamtopnm > ${seq_pnm}

for i in 2 3 5 8 13 21 34
do

    pamcut -w $i -h $i -l $(($i % 17)) -t $(($i %  19)) ${seq_pnm} > ${test_pnm}

    if [ $? -eq 0 ] ; then        
    pnmpad -extend-edge -l=$i -r=$i -t=$i -b=$i ${test_pnm} > ${padded_pnm}

    pamcut -left=0 -width=1 ${test_pnm} |\
      pamenlarge -xscale=$i > ${left_pnm}
    pamcut -right=-1 -width=1  ${test_pnm} |\
      pamenlarge -xscale=$i > ${right_pnm}
    pamcut -top=0 -height=1 ${test_pnm} |\
      pamenlarge -yscale=$i > ${top_pnm}
    pamcut -bottom=-1 -height=1  ${test_pnm} |\
      pamenlarge -yscale=$i > ${bottom_pnm}
    pamcut -left=0 -top=0 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${topleft_pnm}	    
    pamcut -right=-1 -top=0 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${topright_pnm}	    
    pamcut -left=0 -bottom=-1 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${bottomleft_pnm}	    
    pamcut -right=-1 -bottom=-1 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${bottomright_pnm}	    
	    
    pamundice -across=3 -down=3 -listfile=${listfile} |\
	cmp -s - ${padded_pnm} && echo "match" || echo "no match: $i"

    rm ${left_pnm} ${right_pnm} ${top_pnm} ${bottom_pnm} \
       ${topleft_pnm} ${topright_pnm}  ${bottomleft_pnm} ${bottomright_pnm} \
       ${padded_pnm}  ${test_pnm}

    else
	# When generation fails print an error message to stdout rather than comparing
	# two empty files and producing an undesired "match" .

	echo "Test 1.$i test image file generation failed" ;
    fi
    
done

rm ${seq_pnm}

echo "Test 2.  Should print match five times"

for i in 2 7 8 11 12

do
    pbmnoise -randomseed=$((6056 +$i)) $i $i > ${test_pnm} ;
    if [ $? -eq 0 ] ; then

    pnmpad -extend-edge -l=$i -r=$i -t=$i -b=$i ${test_pnm} > ${padded_pnm}
    pamcut -left=0 -width=1 ${test_pnm} |\
	pamenlarge -xscale=$i > ${left_pnm}
    pamcut -right=-1 -width=1  ${test_pnm} |\
      pamenlarge -xscale=$i > ${right_pnm}
    pamcut -top=0 -height=1 ${test_pnm} |\
      pamenlarge -yscale=$i > ${top_pnm}
    pamcut -bottom=-1 -height=1  ${test_pnm} |\
      pamenlarge -yscale=$i > ${bottom_pnm}
    pamcut -left=0 -top=0 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${topleft_pnm}	    
    pamcut -right=-1 -top=0 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${topright_pnm}	    
    pamcut -left=0 -bottom=-1 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${bottomleft_pnm}	    
    pamcut -right=-1 -bottom=-1 -width=1 -height=1 ${test_pnm} |\
      pamenlarge -xscale=$i -yscale=$i > ${bottomright_pnm}	    
	    
    pamundice -across=3 -down=3 -listfile=${listfile} |\
	cmp -s - ${padded_pnm} && echo "match" || echo "no match: $i"

    rm ${left_pnm} ${right_pnm} ${top_pnm} ${bottom_pnm} \
       ${topleft_pnm} ${topright_pnm}  ${bottomleft_pnm} ${bottomright_pnm} \
       ${padded_pnm}  ${test_pnm}

    else
	echo "Test 2.$i test image file generation failed" ;
    fi

done

rm ${listfile}

stretch_pnm=${tmpdir}/stretch.pnm

echo "Test 3.  Should print match eight times"

for i in 1 2
do

    case $i in
    1) pbmnoise -randomseed=6145 1 17  > ${test_pnm} ;;
    2) pamnoise -randomseed=6234 -tupletype="GRAYSCALE" -w 1 -h 12 -d 1 | pgmtopgm > ${test_pnm} ;;
    esac
    
    pamenlarge -xscale=17 ${test_pnm} > ${stretch_pnm}
    if [ $? -eq 0 ] ; then
       
    for leftpad in 0 1 7 16
    do
        pnmpad -extend-edge -l=${leftpad} -r=$((16 - ${leftpad})) ${test_pnm} |\
                cmp -s - ${stretch_pnm} && echo "match" ||\
                    echo "no match: ${generator} ${leftpad}";
    done
    else
	echo "Test 3.$i test image file generation failed" ;
    fi
    rm ${stretch_pnm} ${test_pnm}
done


echo "Test 4.  Should print match eight times"

for i in 1 2
do

    case $i in
    1) pbmnoise -randomseed=6323 23 1  > ${test_pnm} ;;
    2) pamnoise -randomseed=6412 -tupletype="GRAYSCALE" -w 12 -h 1 -d 1 | pgmtopgm > ${test_pnm} ;;
    esac
    
    pamenlarge -yscale=17 ${test_pnm} > ${stretch_pnm}
    if [ $? -eq 0 ] ; then
       
    for toppad in 0 1 2 7
    do
        pnmpad -extend-edge -t=${toppad} -b=$((16 - ${toppad})) ${test_pnm} |\
                cmp -s - ${stretch_pnm} && echo "match" ||\
                    echo "no match: ${generator} ${toppad}";
    done
    else
	echo "Test 4.$i test image file generation failed" ;
    fi
    rm ${stretch_pnm} ${test_pnm}
done


echo "Test 5.  Should print match twelve times"

for i in 1 2 3 4
do
    case $i in
	1) pbmmake -b 1 1 >  ${test_pnm} ;;
        2) pbmmake -w 1 1 >  ${test_pnm} ;;
	3) pgmmake 0.3 1 1 > ${test_pnm} ;;
	4) ppmmake rgbi:0.5/0.3/0.8 1 1 > ${test_pnm} ;;
    esac

    xs=$i; ys=$i
    
    pamenlarge -xscale=$xs -yscale=$ys ${test_pnm} > ${stretch_pnm}
    if [ $? -eq 0 ] ; then
    # center
    pnmpad -extend-edge -w $xs -h $ys ${test_pnm} |\
                cmp -s - ${stretch_pnm} && echo "match" ||\
            echo "no match: ${generator} ${toppad} ${leftpad}"
    # extend bottom and left
    pnmpad -extend-edge -w $xs -h $ys -t=0 -r=0 ${test_pnm} |\
                cmp -s - ${stretch_pnm} && echo "match" ||\
            echo "no match: ${generator} ${toppad} ${leftpad}" ;
    # extend top and right    
    pnmpad -extend-edge -w $xs -h $ys -b=0 -l=0 ${test_pnm} |\
                cmp -s - ${stretch_pnm} && echo "match" ||\
            echo "no match: ${generator} ${toppad} ${leftpad}"
    else
	echo "Test 5.$i test image file generation failed" ;
    fi
    
    rm ${stretch_pnm} ${test_pnm}

done

